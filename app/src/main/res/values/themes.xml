<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.KastorskayaKseniaAndreevna" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Добавьте эти строки для цвета текста -->
        <item name="android:textColor">#FF000000</item> <!-- Черный цвет для всего текста -->
        <item name="android:textColorPrimary">#FF000000</item> <!-- Основной цвет текста -->
        <item name="android:textColorSecondary">#FF000000</item> <!-- Вторичный цвет текста (для подсказок) -->
        <item name="android:textColorHint">#FF666666</item> <!-- Цвет подсказок (серый) -->
        <item name="editTextColor">#FF000000</item> <!-- Цвет текста в EditText -->
    </style>
</resources>